# CampusBite Environment Variables Template (Development / Production Placeholders)

# Server Port
PORT=8080

# Primary Database (PostgreSQL)
DATABASE_URL=postgres://campusbite:campusbite_dev@localhost:5432/campusbite

# Cache & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379/0

# Authentication (Minimum 32 random characters in production)
JWT_SECRET=your-secure-jwt-secret-placeholder

# Razorpay Sandbox / Test Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_placeholder_webhook_secret

# Gemini AI API Key & Model
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-2.5-flash

# Worker & Cache TTLs (Optional)
MENU_CACHE_TTL_SECONDS=60
RESERVATION_WORKER_INTERVAL_SECONDS=30
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=3600

# Initial Cafeteria Admin Provisioning (Required for Seeding)
ADMIN_EMAIL=admin@campusbite.com
ADMIN_PASSWORD=change-me
