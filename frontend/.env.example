# CampusBite Frontend Environment Variables (Vite)

# 1. Local Development (Default / Proxy)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/api/v1/ws

# 2. Production (e.g. Render backend URL for Vercel deployment)
# VITE_API_BASE_URL=https://campusbite-api.onrender.com/api/v1
# VITE_WS_URL=wss://campusbite-api.onrender.com/api/v1/ws
